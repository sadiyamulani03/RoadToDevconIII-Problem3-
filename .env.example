# Privy App credentials - get from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here

# Authorization key for server-side wallet operations (delegated actions signer)
# Generate via: openssl ecparam -name prime256v1 -genkey -noout
# Register public key in Privy Dashboard > Authorization keys > New key quorum
PRIVY_AUTHORIZATION_PRIVATE_KEY=your_authorization_private_key_here
PRIVY_AUTHORIZATION_KEY_ID=your_authorization_key_quorum_id_here
NEXT_PUBLIC_PRIVY_SIGNER_ID=your_signer_id_here

# On-chain config
NEXT_PUBLIC_CONTRIBUTION_CONTRACT=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org
NEXT_PUBLIC_WEEKLY_CONTRIBUTION_WEI=10000000000000000
NEXT_PUBLIC_CHAIN_ID=84532
